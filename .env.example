# ── Environment Variables ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "groq" | "ollama"
LLM_PROVIDER=groq

# Groq API key (get one free at https://console.groq.com)
GROQ_API_KEY=

# Groq model name. Current recommended: llama-3.3-70b-versatile
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768
LLM_MODEL=llama-3.3-70b-versatile

# Ollama settings (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embeddings ───────────────────────────────────────────────────────────────
# Free, runs locally on CPU (~130 MB download on first use)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./vectorstore/chroma
CHROMA_COLLECTION_NAME=ramayana_documents

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVER_TOP_K=5
RETRIEVER_SIMILARITY_THRESHOLD=0.3

# ── Generation ────────────────────────────────────────────────────────────────
MAX_CONTEXT_TOKENS=4000
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
